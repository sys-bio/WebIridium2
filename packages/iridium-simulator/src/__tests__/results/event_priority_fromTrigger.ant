## start=0 end=10 points=100 atol=1e-12 rtol=1e-6 selections=B,k1

const species A = 1

$A -> B; k1

k1 = 1

at B > 3, priority=4, fromTrigger=false: k1 = k1 + 10

at B > 3, priority=3, fromTrigger=false: k1 = k1 * 5

at B > 3, priority=2, fromTrigger=false: k1 = k1 + 9

at B > 3, priority=1, fromTrigger=false: k1 = k1 * 2
