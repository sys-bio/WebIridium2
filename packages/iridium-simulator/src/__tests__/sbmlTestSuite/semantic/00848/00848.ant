model *case00848()

  // Compartments and Species:
  compartment C;
  species S1 in C, S2 in C;

  // Reactions:
  reaction1: S1 -> S2; C*(kf*S1 + -1*kr*S2);

  // Events:
  event1: at 1 after S1 < 0.75: S2 = 1.5;

  // Species initializations:
  S1 = 1/C;
  S1 has substance_per_volume;
  S2 = 2/C;
  S2 has substance_per_volume;

  // Compartment initializations:
  C = 1;
  C has volume;

  // Variable initializations:
  kf = 0.9;
  kr = 0.075;

  // Other declarations:
  const C, kf, kr;

  // Unit definitions:
  unit volume = litre;
  unit substance = mole;
  unit time_unit = second;
  unit substance_per_volume = mole / litre;
end

case00848 is "case00848"