model *case00940()

  // Compartments and Species:
  compartment default_compartment;
  species x in default_compartment;

  // Assignment Rules:
  y := 2 + delay(x, 0.5);

  // Species initializations:
  x = 1*sin(10*time);
  x has substance_per_volume;

  // Compartment initializations:
  default_compartment = 1;
  default_compartment has volume;

  // Other declarations:
  var y;
  const default_compartment;

  // Unit definitions:
  unit volume = litre;
  unit substance = mole;
  unit time_unit = second;
  unit substance_per_volume = mole / litre;

  // SBO terms:
  default_compartment.sboTerm = 410

  // Notes:
  model notes "Originally created by libAntimony 1.4 (using libSBML 5.0.0-a1)"
