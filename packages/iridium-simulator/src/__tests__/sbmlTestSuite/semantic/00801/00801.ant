model *case00801()

  // Compartments and Species:
  compartment C;
  species S1 in C, S2 in C;

  // Reactions:
  reaction1: S1 => S2; C*k;

  // Species initializations:
  S1 = 1/C;
  S1 has substance_per_volume;
  S2 = 0;
  S2 has substance_per_volume;

  // Compartment initializations:
  C = 1;
  C has volume;

  // Variable initializations:
  k = 0.075;

  // Other declarations:
  const C, k;

  // Unit definitions:
  unit volume = litre;
  unit substance = mole;
  unit time_unit = second;
  unit substance_per_volume = mole / litre;

  // SBO terms:
  reaction1.kineticLaw.sboTerm = 47
end

case00801 is "case00801"