  Rinc: at 0.005 after (time - reset) >= 0.005, priority = 1, persistent=false, fromTrigger=false: reset = time, R = R + 0.01;
  maxcheck: at abs(Q - R) > maxdiff: maxdiff = abs(Q - R);
  error_check: at (time >= 99) && (maxdiff < 0.2): errorLow = 1;
