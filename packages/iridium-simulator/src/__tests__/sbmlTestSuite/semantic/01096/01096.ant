model *case01096()

  // Compartments and Species:
  compartment C;
  species S1 in C, S2 in C;

  // Reactions:
  reaction1: S1 -> generatedId_0 S2; C*(kf*S1 + -1*kr*S2);

  // Species initializations:
  S1 = 1/C;
  S1 has substance_per_volume;
  S2 = 0;
  S2 has substance_per_volume;

  // Compartment initializations:
  C = 1;
  C has volume;

  // Variable initializations:
  kf = 0.9;
  kr = 0.075;
  p1 = 0.5;
  generatedId_0 = 4*p1;

  // Other declarations:
  const C, kf, kr, p1;

  // Unit definitions:
  unit volume = litre;
  unit substance = mole;
  unit time_unit = second;
  unit substance_per_volume = mole / litre;
end

case01096 is "case01096"