model *case00310()

  // Compartments and Species:
  compartment C;
  species S1 in C, S2 in C;

  // Assignment Rules:
  C := p1*p2;

  // Rate Rules:
  p2' = 0.1;

  // Reactions:
  reaction1: S1 => S2; C*k1*S1;

  // Species initializations:
  S1 = 1.5/C;
  S1 has substance_per_volume;
  S2 = 0;
  S2 has substance_per_volume;
  C has volume;

  // Variable initializations:
  p1 = 0.1;
  p2 = 1.5;
  k1 = 0.9;

  // Other declarations:
  var C, p2;
  const p1, k1;

  // Unit definitions:
  unit volume = litre;
  unit substance = mole;
  unit time_unit = second;
  unit substance_per_volume = mole / litre;
end

case00310 is "case00310"