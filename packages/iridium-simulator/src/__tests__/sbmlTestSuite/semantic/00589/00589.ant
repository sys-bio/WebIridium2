model *case00589()

  // Compartments and Species:
  compartment C;
  species S1 in C, S2 in C;

  // Reactions:
  reaction1: S1 => S2; C*k1*S1;

  // Species initializations:
  S1 = 0.015;
  S1 has substance_per_area;
  S2 = 0;
  S2 has substance_per_area;

  // Compartment initializations:
  C = 1;
  C has area;

  // Variable initializations:
  k1 = 1;

  // Other declarations:
  const C, k1;

  // Unit definitions:
  unit substance = mole;
  unit area = metre^2;
  unit time_unit = second;
  unit substance_per_area = mole / metre^2;
end

case00589 is "case00589"