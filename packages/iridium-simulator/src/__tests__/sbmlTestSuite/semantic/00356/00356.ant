model *case00356()

  // Compartments and Species:
  compartment C;
  species S1 in C, S2 in C, S3 in C;

  // Reactions:
  reaction1: S1 + S2 => S3; C*k1*S1*S2;
  reaction2: S3 => S1 + S2; C*k2*S3;

  // Events:
  event1: at S1 < 0.75: S2 = k3 + k4;
  event2: at S3 > 1.2: S1 = k3*k4^-1;

  // Species initializations:
  S1 = 1/C;
  S1 has substance_per_volume;
  S2 = 2/C;
  S2 has substance_per_volume;
  S3 = 1/C;
  S3 has substance_per_volume;

  // Compartment initializations:
  C = 1;
  C has volume;

  // Variable initializations:
  k3 = 0.5;
  k4 = 0.5;
  k1 = 0.75;
  k2 = 0.25;

  // Other declarations:
  const C, k3, k4, k1, k2;

  // Unit definitions:
  unit volume = litre;
  unit substance = mole;
  unit time_unit = second;
  unit substance_per_volume = mole / litre;
end

case00356 is "case00356"