model *case00831()

  // Compartments and Species:
  compartment C;
  species S1 in C, S2 in C, S3 in C, S4 in C;

  // Reactions:
  reaction1: S1 -> S2; C*(reaction1_kf*S1 + -1*reaction1_kr*S2);
  reaction2: S3 -> S4; C*(reaction2_kf*S3 + -1*reaction2_kr*S4);

  // Species initializations:
  S1 = 1/C;
  S1 has substance_per_volume;
  S2 = 0;
  S2 has substance_per_volume;
  S3 = 1.5/C;
  S3 has substance_per_volume;
  S4 = 0.5/C;
  S4 has substance_per_volume;

  // Compartment initializations:
  C = 1;
  C has volume;

  // Variable initializations:
  reaction1_kf = 0.8;
  reaction1_kr = 0.06;
  reaction2_kf = 0.9;
  reaction2_kr = 0.075;

  // Other declarations:
  const C;

  // Unit definitions:
  unit volume = litre;
  unit substance = mole;
  unit time_unit = second;
  unit substance_per_volume = mole / litre;
end

case00831 is "case00831"