// Created by libAntimony v3.2.0
model moddef1()

  // Compartments and Species:
  compartment C;
  substanceOnly species s1 in C;

  // Reactions:
  J0:  -> s1; s1*t3*time;

  // Species initializations:
  s1 = 1;

  // Compartment initializations:
  C = 1;

  // Variable initializations:
  t3 = 0.2;

  // Other declarations:
  var t3;
  const C;
end

model *case01144()

  // Sub-modules, and any changes to those submodules:
  sub1: moddef1(), timeconv = timeconv, extentconv = extentconv;
  sub1.t3 is t3;

  // Variable initializations:
  timeconv = 60;
  extentconv = 1000;

  // Other declarations:
  const t3, timeconv, extentconv;
end

case01144 is "case01144"