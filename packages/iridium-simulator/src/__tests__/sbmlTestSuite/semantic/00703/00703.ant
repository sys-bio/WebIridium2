model *case00703()

  // Compartments and Species:
  compartment C;
  species S1 in C, S2 in C, S3 in C, S4 in C;

  // Assignment Rules:
  S4 := k*S2;

  // Reactions:
  reaction1: S1 + S2 => S3; C*reaction1_k*S1*S2;
  reaction2: S3 => S1 + S2; C*reaction2_k*S3;

  // Species initializations:
