model *case01256()

  // Compartments and Species:
  compartment c;
  species S1 in c;

  // Assignment Rules:
  p2 := rateOf(S1);

  // Reactions:
  J0:  => S1; 0.01*S1;

  // Species initializations:
  S1 = 1/c;

  // Compartment initializations:
  c = 1;

  // Other declarations:
  var p2;
  const c;
end

case01256 is "case01256"