// Created by libAntimony v3.0.0
model *case00448()

  // Compartments and Species:
  compartment C;
  species S1 in C, S2 in C, S3 in C, S4 in C;

  // Assignment Rules:
  S2_S3_stoichiometry := 4*p1;

  // Reactions:
  reaction1: S1 + S2 => S2_S3_stoichiometry S3 + S4; C*k1*S1*S2;
  reaction2: 2 S3 + S4 => S1 + S2; C*k2*S3*S4;

  // Events:
  event1: at 0.5 after S4 > S2: S1 = (1/5);
  event2: at 1.5 after S3 > (1/4): S4 = (1/10);

  // Species initializations:
  S1 = 0.1/C;
  S1 has substance_per_volume;
  S2 = 0.12/C;
  S2 has substance_per_volume;
  S3 = 0.2/C;
  S3 has substance_per_volume;
  S4 = 0.1/C;
  S4 has substance_per_volume;

  // Compartment initializations:
  C = 1;
  C has volume;

  // Variable initializations:
  k1 = 7.5;
  k2 = 2.5;
  p1 = 0.5;

  // Other declarations:
  const C, k1, k2, p1;

  // Unit definitions:
  unit volume = litre;
  unit substance = mole;
  unit substance_per_volume = mole / litre;
end

case00448 is "case00448"
