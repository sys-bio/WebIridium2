  k2 = 0.3;
  p1 = 1;

  // Other declarations:
  const compartment_, k1, k2, p1;

  // Unit definitions:
  unit volume = litre;
  unit substance = mole;
  unit substance_per_volume = mole / litre;

  // Display Names:
