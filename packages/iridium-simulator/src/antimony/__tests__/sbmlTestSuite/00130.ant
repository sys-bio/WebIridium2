  compartment compartment_;
  species S1 in compartment_, S2 in compartment_, S3 in compartment_;

  // Assignment Rules:
  reaction2_S3_stoichiometry := 2*p1;

  // Reactions:
  reaction1: S1 + S2 => S3; compartment_*k1*S1*S2;
  reaction2: reaction2_S3_stoichiometry S3 => S1 + S2; compartment_*k2*S3;

  // Species initializations:
  S1 = 0.0001/compartment_;
  S1 has substance_per_volume;
