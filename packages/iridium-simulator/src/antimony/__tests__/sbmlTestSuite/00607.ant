## start=0.0 end=1.0 points=50 atol=1e-08 rtol=0.0001 selections=S1,S2,S3,S4 amounts=
## tags=Compartment,Species,Reaction,Parameter,AssignmentRule,Concentration,NonUnityCompartment,InitialValueReassigned

// Created by libAntimony v3.0.0
model *case00607()

  // Compartments and Species:
  compartment C;
  species S1 in C, S2 in C, S3 in C, $S4 in C;

  // Assignment Rules:
  S4 := k3*S2;

  // Reactions:
  reaction1: S1 + S2 => S3; C*k1*S1*S2;
  reaction2: S3 => S1 + S2; C*k2*S3;

  // Species initializations:
  S1 = 1e-05;
  S1 has substance_per_volume;
  S2 = 1.5e-05;
  S2 has substance_per_volume;
  S3 = 1e-05;
  S3 has substance_per_volume;
  S4 has substance_per_volume;

  // Compartment initializations:
  C = 0.1;
  C has volume;

  // Variable initializations:
  k3 = 1.5;
  k1 = 150000;
  k2 = 5;

  // Other declarations:
  const C, k3, k1, k2;

  // Unit definitions:
  unit volume = litre;
  unit substance = mole;
  unit time_unit = time_unit;
  unit substance_per_volume = mole / litre;
end

case00607 is "case00607"
