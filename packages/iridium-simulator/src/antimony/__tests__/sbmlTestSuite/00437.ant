  // Variable initializations:
  k1 = 0.75;
  k2 = 0.25;

  // Other declarations:
  const C, k1, k2;

  // Unit definitions:
  unit volume = litre;
  unit substance = mole;
  unit time_unit = time_unit;
  unit substance_per_volume = mole / litre;
end

