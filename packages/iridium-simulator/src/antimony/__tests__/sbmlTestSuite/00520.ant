## tags=StoichiometryMath,Compartment,Species,Reaction,Parameter,InitialAssignment,Amount,AssignedConstantStoichiometry,DefaultValue,NonUnityStoichiometry

// Created by libAntimony v3.0.0
model *case00520()

  // Compartments and Species:
  compartment C;
  species S1 in C, S2 in C, S3 in C;

  // Assignment Rules:
  S2_S3_stoichiometry := 4*p1;

  // Reactions:
  reaction1: S1 + S2 => S2_S3_stoichiometry S3; C*k1*S1*S2;
  reaction2: S3 => S1 + S2; C*k2*S3;

  // Species initializations:
  S1 = 2*p1;
  S1 has substance_per_volume;
  S2 = 0.0002/C;
  S2 has substance_per_volume;
  S3 = 0.0001/C;
  S3 has substance_per_volume;

  // Compartment initializations:
  C = 1;
  C has volume;

  // Variable initializations:
  p1 = 1.25e-05;
  k1 = 0.75;
  k2 = 0.25;
  p2 = 0.5;

  // Other declarations:
  const C, p1, k1, k2, p2;

  // Unit definitions:
  unit volume = litre;
  unit substance = mole;
  unit substance_per_volume = mole / litre;
end

case00520 is "case00520"
