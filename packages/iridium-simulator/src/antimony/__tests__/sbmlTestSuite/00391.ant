## start=0.0 end=2.5 points=50 atol=1e-07 rtol=0.0001 selections=S1,S2,S3,S4 amounts=S1,S2,S3,S4
## tags=StoichiometryMath,Compartment,Species,Reaction,Parameter,EventNoDelay,Amount,AssignedConstantStoichiometry,DefaultValue,NonUnityStoichiometry

// Created by libAntimony v3.0.0
model *case00391()

  // Compartments and Species:
  compartment C;
  species S1 in C, S2 in C, S3 in C, S4 in C;

  // Assignment Rules:
  S2_S3_stoichiometry := 4*p1;

  // Reactions:
  reaction1: S1 + S2 => S2_S3_stoichiometry S3 + S4; C*k1*S1*S2;
  reaction2: 2 S3 + S4 => S1 + S2; C*k2*S3*S4;

  // Events:
  event1: at S4 > S2: S1 = (1/5000);
  event2: at S3 > (1/4000): S4 = (1/10000);

  // Species initializations:
  S1 = 0.0001/C;
  S1 has substance_per_volume;
  S2 = 0.00012/C;
  S2 has substance_per_volume;
  S3 = 0.0002/C;
  S3 has substance_per_volume;
  S4 = 0.0001/C;
  S4 has substance_per_volume;

  // Compartment initializations:
  C = 1;
  C has volume;

  // Variable initializations:
  k1 = 7500;
  k2 = 2500;
  p1 = 0.5;

  // Other declarations:
  const C, k1, k2, p1;

  // Unit definitions:
  unit volume = litre;
  unit substance = mole;
  unit substance_per_volume = mole / litre;
end

case00391 is "case00391"
