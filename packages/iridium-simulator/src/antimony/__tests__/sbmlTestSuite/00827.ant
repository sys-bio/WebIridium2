model *case00827()

  // Compartments and Species:
  compartment C;
  species S1 in C, S2 in C;

  // Assignment Rules:
  S1_S2_stoichiometry := 4*p1;

  // Reactions:
  reaction1: S1 -> S1_S2_stoichiometry S2; C*(kf*S1 + -1*kr*S2);

