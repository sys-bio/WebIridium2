model submod(q, r, x)

  // Compartments and Species:
  species S1;

  // Assignment Rules:
  q := x - 3;
  unused2 := 3;

  // Rate Rules:
  x' = 0.2;
  unused' = 0.3;

  // Reactions:
  _J0: S1 -> ; k1*S1;

  // Events:
  _E0: at x > 0.1515, priority = q: y = 4;
  _E1: at x > 0.1515, priority = r: y = 5;

  // Species initializations:
  S1 = 7.2;

  // Variable initializations:
  x = 3;
  y = 8.8;
  r = -4;
  unused = 10;
  k1 = 1.06;

  // Other declarations:
  var x, q, y, unused2, unused;
  const r, k1;
end

submod is "submod"

model *case01169()

