  compartment compartment_;
  species S1 in compartment_, S2 in compartment_, S3 in compartment_;

  // Assignment Rules:
  S3_S1_stoichiometry := 2*p1;
  S1_S2_stoichiometry := 2*p1;

  // Reactions:
  reaction1: S1 + S2 => S3; compartment_*k1*S1*S2;
  reaction2: S3 => S3_S1_stoichiometry S1 + S1_S2_stoichiometry S2; compartment_*k2*S3;

