## start=0.0 end=5.0 points=50 atol=0.001 rtol=0.0001 selections=S1,S2,S3,S4 amounts=S1,S2,S3,S4
## tags=StoichiometryMath,Compartment,Species,Reaction,Parameter,RateRule,EventWithDelay,Amount,AssignedConstantStoichiometry,DefaultValue,NonUnityStoichiometry

// Created by libAntimony v3.0.0
model *case00731()

  // Compartments and Species:
  compartment C;
  species S1 in C, S2 in C, S3 in C, $S4 in C;

  // Assignment Rules:
  S1_S2_stoichiometry := 4*p1;

  // Rate Rules:
  S4' = 1;

  // Reactions:
  reaction1: S1 + S2 => S3; C*k1*S1*S2;
  reaction2: S3 => S1 + S1_S2_stoichiometry S2; C*k2*S3;

  // Events:
  event1: at 2.5 after S1 < 0.5: S2 = 2;

  // Species initializations:
  S1 = 1.5/C;
  S1 has substance_per_volume;
  S2 = 2/C;
  S2 has substance_per_volume;
  S3 = 1.5/C;
  S3 has substance_per_volume;
  S4 = 1/C;
  S4 has substance_per_volume;

  // Compartment initializations:
  C = 1;
  C has volume;

  // Variable initializations:
  k1 = 0.75;
  k2 = 0.00025;
  p1 = 0.25;

  // Other declarations:
  const C, k1, k2, p1;

  // Unit definitions:
  unit volume = litre;
  unit substance = mole;
  unit substance_per_volume = mole / litre;
end

case00731 is "case00731"
