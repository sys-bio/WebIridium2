## start=0 end=10 points=100 atol=1e-12 rtol=1e-6 selections=A,B,C,D,E

// This tests that the priorities are based on the current state.

A' = 5
A = 0
B = 0
C = 2
D = 0
E = 1

at A > 10: B = 3
at B > 2, priority=1000000000000000000000000: C = 0.5, D = 6
at B > 2, priority=2 + C^2, fromTrigger=false: E = E * 5
at B > 2, priority=2 + C, fromTrigger=false: E = E + 10 // This one should run first
