## start=0 end=30 points=300 atol=1e-12 rtol=1e-6 selections=A,B,C,k1,k2,e1,e2,e3

A -> B; k1*A
B -> C; k2*B
k1 = 0.35; k2 = 0.2
B = 0; C = 0
A = 10

e1 = 0
e2 = 0
e3 = 0

at and(), t0=false: k1 = 2
at or(), t0=false: k2 = 10
at xor(), t0=false: k2=99

at and(C > 4, B > 3): e1 = e1 + 3
at or(C > 7, B > 6): e2 = e2 + 3
at xor(C > 3, B > 4): e3 = e3 + 3
