{
  "name": "iridium-simulator",
  "description": "simulator for iridium using CVODE and WASM JIT",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./dsl": "./src/ir/dsl.ts",
    "./antimony": "./src/antimony/index.ts"
  },
  "scripts": {
    "antlr4ts": "antlr4ts ./src/antimony/grammar/Antimony.g4 -visitor -Xexact-output-dir -o ./src/antimony/generated/"
  },
  "dependencies": {
    "@nodable/sax": "^1.2.1",
    "antlr4ts": "^0.5.0-alpha.4"
  },
  "devDependencies": {
    "antlr4ts-cli": "^0.5.0-alpha.4"
  }
}
