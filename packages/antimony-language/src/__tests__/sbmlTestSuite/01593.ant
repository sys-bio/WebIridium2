  maxcheck: at abs(Q - R) > maxdiff: maxdiff = abs(Q - R);
  error_check: at (time >= 99) && (maxdiff < 0.2): errorLow = 1;
  error_check2: at maxdiff >= 4: errorHigh = 1;

  // Variable initializations:
  reset = 0;
  Q = 0;
  R = 0;
  maxdiff = 0;
  errorLow = 0;
  errorHigh = 0;

  // Other declarations:
  var reset, Q, R, maxdiff, errorLow, errorHigh, S, S2;
end

