model *case01593()

  // Assignment Rules:
  S := Q + R;
  S2 := delay(Q, 1) + delay(R, 1);

  // Rate Rules:
  reset' = 1;

  // Events:
  Qinc: at reset >= 0.01, priority = 1, persistent=false: Q = Q + 0.01, reset = 0;
