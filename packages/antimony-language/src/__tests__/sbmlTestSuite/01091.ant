model *case01091()

  // Compartments and Species:
  compartment C;
  species S1 in C, S2 in C, S3 in C, $S4 in C;

  // Rate Rules:
  S4' = k2*4e-06;

  // Reactions:
  reaction1: S1 + generatedId_0 S2 => S3; C*k1*S1*S2;
