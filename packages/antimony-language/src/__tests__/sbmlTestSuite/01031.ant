## tags=Amount,ReversibleReaction,LocalParameters

// Created by libAntimony v3.0.0
model *case01031()

  // Compartments and Species:
  compartment C;
  species S1 in C, S2 in C, S3 in C, S4 in C;

  // Reactions:
  reaction1: S2 -> S1; -(C*(reaction1_kf*S1 + -1*reaction1_kr*S2));
  reaction2: S4 -> S3; -(C*(reaction2_kf*S3 + -1*reaction2_kr*S4));

  // Species initializations:
  S1 = 1/C;
