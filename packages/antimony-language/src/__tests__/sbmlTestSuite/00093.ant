  k1 = 0.015;
  k3 = 1.5;

  // Other declarations:
  const compartment_, k2, k1, k3;

  // Unit definitions:
  unit volume = litre;
  unit substance = mole;
  unit time_unit = time_unit;
  unit substance_per_volume = mole / litre;

  // Display Names:
  compartment_ is "compartment";
