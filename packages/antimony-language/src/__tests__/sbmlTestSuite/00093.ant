model *case00093()

  // Compartments and Species:
  compartment compartment_;
  species S1 in compartment_, $S2 in compartment_, S3 in compartment_, $S4 in compartment_;

  // Assignment Rules:
  S4 := k3*S1;

  // Rate Rules:
  S2' = k2*S3 + -1*k1*S1;

  // Reactions:
  reaction1: S1 => S3; compartment_*k1*S1;
