## start=0.0 end=1.0 points=10 atol=0.0001 rtol=0.0001 selections=S,D,A__submod1__E,A__submod1__ES,comp amounts=S,D,A__submod1__E,A__submod1__ES
## tags=Amount,comp:SubmodelOutput

// Created by libAntimony v3.0.0
model enzyme()

  // Compartments and Species:
  compartment comp;
  species S in comp, E in comp, D in comp, ES in comp;

  // Reactions:
  J0: S + E -> ES; (S + E)/ES;
  J1: ES -> E + D; ES/(E + D);

  // Species initializations:
  S = 10;
  E = 1;
  D = 15;
  ES = 1;

  // Compartment initializations:
  comp = 1;

  // Other declarations:
  const comp;
end

enzyme is "enzyme"

model *indirect()

  // Sub-modules, and any changes to those submodules:
  submod1: enzyme();
end

indirect is "indirect"
