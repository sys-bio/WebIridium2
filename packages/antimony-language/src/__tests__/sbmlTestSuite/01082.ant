  // Variable initializations:
  p1 = 0.0125;
  k1 = 0.75;
  k2 = 0.25;
  p2 = 0.5;
  generatedId_0 = 4*p1;

  // Other declarations:
  const C, p1, k1, k2, p2;

  // Unit definitions:
  unit volume = litre;
  unit substance = mole;
  unit time_unit = time_unit;
  unit substance_per_volume = mole / litre;
end

