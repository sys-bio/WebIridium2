  // Compartment initializations:
  C = 1;
  C has volume;

  // Variable initializations:
  k1 = 1.5;

  // Other declarations:
  const C, k1;

  // Unit definitions:
  unit volume = litre;
  unit substance = mole;
  unit time_unit = time_unit;
  unit substance_per_volume = mole / litre;
end

case00649 is "case00649"
