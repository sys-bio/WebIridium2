## start=0.0 end=5.0 points=50 atol=0.001 rtol=0.0001 selections=S1,S2,S3,S4 amounts=S1,S2,S3,S4
## tags=Amount,EventIsPersistent

// Created by libAntimony v3.0.0
model *case00850()

  // Compartments and Species:
  compartment C;
  species S1 in C, S2 in C, S3 in C, S4 in C;

  // Reactions:
  reaction1: S1 -> S2; C*(kf*S1 + -1*kr*S2);
  reaction2: S3 -> S4; C*(k1*S3 + -1*k2*S4);

  // Events:
  event1: at 2 after S1 < 0.5: S2 = 1.5;
  event2: at 2.5 after S3 < 0.75: S4 = 0.5;

  // Species initializations:
  S1 = 1/C;
  S1 has substance_per_volume;
  S2 = 2/C;
  S2 has substance_per_volume;
  S3 = 1/C;
  S3 has substance_per_volume;
  S4 = 1.5/C;
  S4 has substance_per_volume;

  // Compartment initializations:
  C = 1;
  C has volume;

  // Variable initializations:
  k1 = 0.75;
  k2 = 0.15;
  kf = 0.9;
  kr = 0.075;

  // Other declarations:
  const C, k1, k2, kf, kr;

  // Unit definitions:
  unit volume = litre;
  unit substance = mole;
  unit time_unit = time_unit;
  unit substance_per_volume = mole / litre;
end

case00850 is "case00850"
