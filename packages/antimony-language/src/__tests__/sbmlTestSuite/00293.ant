## start=0.0 end=6.0 points=50 atol=0.001 rtol=0.0001 selections=S1,S3,S5 amounts=S1,S3,S5
## tags=Amount,InitialValueReassigned,MultiCompartment,ReversibleReaction

// Created by libAntimony v3.0.0
model *case00293()

  // Compartments and Species:
  compartment compartment_, compartment1;
  species S1 in compartment_, S3 in compartment1, $S5 in compartment1;

  // Assignment Rules:
  S5 := k4*S3;

  // Reactions:
  reaction1: S1 => S3; compartment_*k1*S1;
  reaction2: S3 -> S1; compartment1*k2*(S3 + -1*S1);

  // Species initializations:
  S1 = 1/compartment_;
  S1 has substance_per_volume;
  S3 = 0;
  S3 has substance_per_volume;
  S5 has substance_per_volume;

  // Compartment initializations:
  compartment_ = 1;
  compartment_ has volume;
