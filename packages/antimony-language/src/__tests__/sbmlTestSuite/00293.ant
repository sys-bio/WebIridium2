  // Variable initializations:
  k4 = 0.5;
  k1 = 0.75;
  k2 = 0.25;

  // Other declarations:
  const compartment_, compartment1, k4, k1, k2;

  // Unit definitions:
  unit volume = litre;
  unit substance = mole;
  unit area = metre^2;
  unit length = metre;
  unit extent = substance;
  unit time_unit = second;
  unit substance_per_volume = mole / litre;

  // Display Names:
  compartment_ is "compartment";
end

case00293 is "case00293"
